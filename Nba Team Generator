#The Base class of the program
class Team:
    def __init__(self, name, data):
        self.name = name
        self.players = data["players"]    
        self.coach = data ["coach"]
        self.sixth = data ["sixth"]
#Gets the player from the user number
    def get_player(self, number):
        return self.players[number - 1]
#The subclass of the program 
class NBATeam(Team):
    def get_info(self, number): #Gets the info for the number and teams
        player = self.get_player(number)
        return (
            f"Team: {self.name}\n"
            f"Player: {player}\n"
            f"coach: {self.coach}\n"
            f"6th Man: {self.sixth}")
#GUI Class
class App:
    def __init__(self, root):
        self.root = root
        self.root.title("NBA GENERATOR")
#Window Title for the program
        self.label = tk.Label(root, text="Pick a number from 1-5")
        self.label.pack()
#Label for the program
        self.entry = tk.Entry(root)
        self.entry.pack()

        self.button = tk.Button(root, text="Get An NBA team", command=self.get_result)
        self.button.pack()
#Gets the result for the label
        self.result = tk.Label(root, text="")
        self.result.pack()
#The list for the team objects
        self.teams = []
        for name in nba_teams: #adds every team onto the list
            team = NBATeam(name, nba_teams[name])
            self.teams.append(team)
    def get_result(self): #Gets the results
        try:
            num = int(self.entry.get()) #The users input into the program
            if num < 1 or num > 5:
                self.result["text"] = "Enter a number between 1-5"
                return
            team = random.choice(self.teams)
            info = team.get_info(num)
            self.result["text"] = info
        except ValueError: #Handles the errors in the program
            self.result["text"] = "Invalid Input. Enter a number"
#Runs the program in the tkintker module
root = tk.Tk()
app = App(root)
root.mainloop()
